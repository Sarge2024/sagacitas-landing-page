# GEMINI_API_KEY removida em 2026-09-22 (ver histórico do repo) — o chat do
# site (api/chat.ts) passou a usar Hugging Face, mesma chave abaixo.

# HUGGINGFACE_API_KEY: usada pelas Vercel Functions api/chat.ts (chat do
# site) E api/format-lesson.ts (server-side, botão "Auto-Formatar (IA)" do
# AdminSlideEditor). Precisa da permissão "Inference Providers" habilitada
# em huggingface.co/settings/tokens.
# NUNCA renomear para VITE_HUGGINGFACE_API_KEY nem ler via import.meta.env em
# código que roda no navegador — isso expõe a chave no bundle JS pra
# qualquer visitante do site (já foi um bug real aqui, corrigido em 2026-09-22).
HUGGINGFACE_API_KEY="MY_HUGGINGFACE_API_KEY"

# BLOB_READ_WRITE_TOKEN: usada pela Vercel Function api/blob-upload.ts
# (server-side, autoriza o upload de imagens das aulas no Class Studio).
# Provisionada automaticamente pela Vercel ao conectar um Blob Store a este
# projeto (Storage → Create Database → Blob) — não precisa gerar manualmente.
# NUNCA renomear para VITE_BLOB_READ_WRITE_TOKEN nem ler via import.meta.env
# em código que roda no navegador.
BLOB_READ_WRITE_TOKEN="MY_BLOB_READ_WRITE_TOKEN"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
